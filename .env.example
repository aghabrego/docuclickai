# DocuClickAI — variables de entorno
#
# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env
#
# El binario y los modulos del helper cargan .env automaticamente al
# importarse (si existe). Tambien puedes exportar las variables en tu
# shell y tendran el mismo efecto.

# ---------------------------------------------------------------
# OpenAI (gpt-4o-mini, gpt-4o, o1-*, etc.)
# ---------------------------------------------------------------
# Requerido si usas --model gpt-* o similar.
# Obtenla en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-reemplaza-con-tu-key-real

# Base URL del endpoint compatible con la API de OpenAI.
# Defaults a https://api.openai.com/v1 si esta vacia.
# Cambiala para Azure OpenAI, OpenRouter, o un proxy local:
#   Azure:   https://<recurso>.openai.azure.com/openai/deployments/<deploy>/v1
#   OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# ---------------------------------------------------------------
# Redis (opcional, solo si no usas --no-publish)
# ---------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---------------------------------------------------------------
# Ollama (opcional, solo si quieres sobreescribir el default)
# ---------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434
