#!/usr/bin/env python3
"""Entry point ejecutable de DocuClickAI.

Uso:
    ./docuclickai --pdf ruta/al.pdf [--out transfers.json] [--no-publish]

Salida por defecto: ``<proyecto>/output/transfers.json``.
Artefactos intermedios: ``<proyecto>/tmp/session_<ts>_<token>/``.

Eventos Redis (canal ``pdf.processed`` y ``pdf.error``): se publican por
cada tienda procesada y al final del PDF. Desactivar con ``--no-publish``.
"""
from __future__ import annotations

import sys
from pathlib import Path

# Permite ejecutar tanto como entry point (./docuclickai) como módulo.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from main import parse_args, main as core_main  # noqa: E402
from tmp_manager import (  # noqa: E402
    lazy_cleanup, new_session_dir, session_id_from_path, write_artifact,
)

PROJECT_ROOT = Path(__file__).resolve().parent.parent


def make_logger(session_dir):
    def _log(name: str, content: str) -> None:
        suffix = "json" if name.startswith("ollama_") else "txt"
        try:
            write_artifact(session_dir, name, content, suffix=suffix)
        except Exception:  # noqa: BLE001
            pass
    return _log


def main() -> int:
    args = parse_args(sys.argv[1:])

    # Si NO es --no-publish, ping a Redis ANTES de crear sesión tmp ni
    # tocar el PDF, para fail-hard limpio (exit 4 sin trabajo inútil).
    # Usamos redis.Redis() directo (sin EventPublisher) porque el sid aún
    # no existe en este punto.
    if not args.no_publish:
        import redis as _redis  # noqa: PLC0415
        from events import RedisPublishError  # noqa: PLC0415
        try:
            r = _redis.Redis(
                host=args.redis_host or "localhost",
                port=args.redis_port or 6379,
                socket_timeout=5.0,
                socket_connect_timeout=5.0,
            )
            r.ping()
            r.close()
        except Exception as exc:  # noqa: BLE001
            print(f"Error Redis: {exc}", file=sys.stderr)
            return 4

    # Limpieza tmp + sesión tras confirmar que Redis responde.
    removed = lazy_cleanup(PROJECT_ROOT)
    if removed:
        print(f"[tmp] {removed} entrada(s) antiguas purgadas (>24h).", flush=True)
    session = new_session_dir(PROJECT_ROOT)
    sid = session_id_from_path(session)
    print(f"[tmp] sesión: {session.relative_to(PROJECT_ROOT)} (sid={sid})", flush=True)

    # core_main parsea los args otra vez (idempotente), crea el publisher
    # con el sid inyectado, y maneja exit codes 0/1/2/3/4 incluyendo la
    # emisión de pdf.error. Inyectamos el logger para los artefactos tmp/.
    return core_main(sys.argv[1:], log=make_logger(session), session_id=sid)


if __name__ == "__main__":
    raise SystemExit(main())
