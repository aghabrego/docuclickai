#!/usr/bin/env python3
"""Entry point ejecutable de DocuClickAI.

Uso:
    ./docuclickai --pdf ruta/al.pdf [--out transfers.json] [--no-publish]

Salida por defecto: ``<proyecto>/output/transfers.json``.
Artefactos intermedios: ``<proyecto>/tmp/session_<ts>_<token>/``.

Eventos Redis (canal ``pdf.processed`` y ``pdf.error``): se publican por
cada tienda procesada y al final del PDF. Desactivar con ``--no-publish``.

Pre-flight (solo en entry point, no en ``python -m main``):
1. Detecta Ollama → exit 5 si no está (no se autoinstala).
2. Detecta modelo → exit 6 si falta (pregunta o ``--auto-pull-model``).

Exit codes:
  0 OK | 1 error inesperado | 2 schema | 3 LLM (Ollama u OpenAI, procesamiento)
  4 Redis | 5 Ollama (preflight) | 6 modelo Ollama (preflight)
  7 OpenAI/API key (preflight)
"""
from __future__ import annotations

import sys
from pathlib import Path

# Permite ejecutar tanto como entry point (./docuclickai) como módulo.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from main import parse_args, main as core_main  # noqa: E402
from tmp_manager import (  # noqa: E402
    lazy_cleanup, new_session_dir, session_id_from_path, write_artifact,
)
from preflight import PreflightError, run_preflight  # noqa: E402


def _resolve_project_root() -> Path:
    """Raíz del proyecto donde van tmp/ y output/.

    Estrategia (en orden):
    1. ``$DOCUCLICKAI_HOME`` si está definida y existe.
    2. CWD del usuario (donde se ejecutó el binario). Esto es lo correcto
       para el binario empaquetado (PyInstaller): tmp/ queda al lado del
       usuario, no dentro del bundle extraído a /tmp/.

    Para ``./helper/docuclickai`` desde el repo, el CWD suele ser la raíz
    del proyecto (que es lo que queremos). Para ``python main.py``, igual.
    """
    env = os.environ.get("DOCUCLICKAI_HOME")
    if env:
        p = Path(env).expanduser().resolve()
        if p.is_dir():
            return p
    return Path.cwd().resolve()


import os  # noqa: E402

PROJECT_ROOT = _resolve_project_root()


def make_logger(session_dir):
    def _log(name: str, content: str) -> None:
        suffix = "json" if name.startswith("ollama_") else "txt"
        try:
            write_artifact(session_dir, name, content, suffix=suffix)
        except Exception:  # noqa: BLE001
            pass
    return _log


def main() -> int:
    args = parse_args(sys.argv[1:])

    # 1. PRE-FLIGHT: Ollama + modelo. Fail-fast ANTES de cualquier side-effect
    # (no se crea sesión tmp ni se hace ping a Redis si Ollama no está).
    try:
        run_preflight(
            model=args.model,
            host=args.host,
            auto_pull=args.auto_pull_model,
            skip_ollama=args.skip_preflight,
            skip_model=args.skip_preflight,
            openai_base_url=args.openai_base_url,
            openai_api_key=args.openai_api_key,
        )
    except PreflightError as exc:
        print(f"Error preflight: {exc}", file=sys.stderr)
        return exc.exit_code

    # 2. Pre-check Redis (solo si no es --no-publish). Fail-hard limpio.
    if not args.no_publish:
        import redis as _redis  # noqa: PLC0415
        try:
            r = _redis.Redis(
                host=args.redis_host or "localhost",
                port=args.redis_port or 6379,
                socket_timeout=5.0,
                socket_connect_timeout=5.0,
            )
            r.ping()
            r.close()
        except Exception as exc:  # noqa: BLE001
            print(f"Error Redis: {exc}", file=sys.stderr)
            return 4

    # 3. Limpieza tmp + sesión tras confirmar pre-flight + Redis.
    removed = lazy_cleanup(PROJECT_ROOT)
    if removed:
        print(f"[tmp] {removed} entrada(s) antiguas purgadas (>24h).", flush=True)
    session = new_session_dir(PROJECT_ROOT)
    sid = session_id_from_path(session)
    print(f"[tmp] sesión: {session.relative_to(PROJECT_ROOT)} (sid={sid})", flush=True)

    # 4. core_main: parsea args (idempotente), crea el publisher con el sid,
    # maneja exit codes 0/1/2/3/4 + emisión de pdf.error. Inyectamos log.
    return core_main(sys.argv[1:], log=make_logger(session), session_id=sid)


if __name__ == "__main__":
    raise SystemExit(main())
